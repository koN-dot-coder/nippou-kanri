<!DOCTYPE html>
<html lang="ja">
  <head>
    <title><%= content_for(:title) || "ひとめ日報" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <div class="header-inner">
        <%# TODO(B-2): "#" を root_path に差し替える %>
        <%= link_to "ひとめ日報", "#", class: "app-name" %>

        <%# TODO(A-2): A-2 マージ後は「user_signed_in?」だけにする（Devise 設定前は user_signed_in? が無いため） %>
        <% if respond_to?(:user_signed_in?) && user_signed_in? %>
          <% if current_user.manager? %>
            <span class="role-label"><span class="icon icon-manager" aria-hidden="true"></span>上司の画面</span>
            <%# TODO(B-2): "#" をそれぞれ daily_reports_path / calendar_path に差し替える %>
            <% nav_links = [
              ["要約一覧", "#", "icon-list"],
              ["提出カレンダー", "#", "icon-calendar"]
            ] %>
          <% else %>
            <span class="role-label"><span class="icon icon-member" aria-hidden="true"></span>部下の画面</span>
            <%# TODO(B-2): "#" をそれぞれ new_daily_report_path / my_daily_reports_path に差し替える %>
            <% nav_links = [
              ["日報を書く", "#", "icon-pencil"],
              ["自分の日報", "#", "icon-list"]
            ] %>
          <% end %>

          <nav class="header-nav">
            <% nav_links.each do |label, path, icon| %>
              <%= link_to path, class: ("current" if current_page?(path)) do %>
                <span class="icon <%= icon %>" aria-hidden="true"></span><%= label %>
              <% end %>
            <% end %>
            <%= button_to destroy_user_session_path, method: :delete do %>
              <span class="icon icon-logout" aria-hidden="true"></span>ログアウト
            <% end %>
          </nav>
        <% end %>
      </div>
    </header>

    <main class="page">
      <% flash.each do |type, message| %>
        <p class="flash flash-<%= type %>"><%= message %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
